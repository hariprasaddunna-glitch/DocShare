BASE_URL=http://localhost:3000
ADMIN_PASSWORD=change-me
# Storage: local | gdrive | s3
STORAGE=local
# Google Drive (console.cloud.google.com -> OAuth client; redirect URI = BASE_URL/admin/gdrive/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# S3-compatible (AWS S3, Cloudflare R2, Backblaze B2, Wasabi)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
